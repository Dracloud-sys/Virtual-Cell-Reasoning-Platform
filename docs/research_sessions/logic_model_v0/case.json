{
 "about": "Abstract reference case for the logic engine. U is an effective external input, S an intermediate state, P a state of interest. Not a model of any named molecule; the rules are candidates stated by the host for testing the engine.",
 "models": [
  {
   "id": "A_input_dependent",
   "version": "v0",
   "description": "P follows S, S follows U. No self-maintenance.",
   "components": [
    {"id": "U", "kind": "input", "description": "effective external input (abstract)"},
    {"id": "S", "kind": "internal", "description": "intermediate state responding to U"},
    {"id": "P", "kind": "internal", "description": "state of interest"}
   ],
   "rules": [
    {"id": "R1", "target": "S", "expr": {"var": "U"}, "stated_by": "host", "assumptions": ["S responds to U within one update."]},
    {"id": "R2", "target": "P", "expr": {"var": "S"}, "stated_by": "host", "assumptions": ["P needs S at the previous update."]}
   ],
   "update": "synchronous"
  },
  {
   "id": "B_self_maintaining",
   "version": "v0",
   "description": "As A, but P, once active, keeps itself active.",
   "components": [
    {"id": "U", "kind": "input", "description": "effective external input (abstract)"},
    {"id": "S", "kind": "internal", "description": "intermediate state responding to U"},
    {"id": "P", "kind": "internal", "description": "state of interest"}
   ],
   "rules": [
    {"id": "R1", "target": "S", "expr": {"var": "U"}, "stated_by": "host", "assumptions": ["S responds to U within one update."]},
    {"id": "R2", "target": "P", "expr": {"or": [{"var": "S"}, {"var": "P"}]}, "stated_by": "host", "assumptions": ["Self-maintenance of P is stated as a candidate rule, not observed."]}
   ],
   "update": "synchronous"
  }
 ],
 "steps": 6,
 "scenarios": {
  "s1_input_on": {
   "initial": {"S": true, "P": true},
   "inputs": {"U": [{"start": 0, "end": null, "value": true}]},
   "clamps": []
  },
  "s2_input_off": {
   "initial": {"S": true, "P": true},
   "inputs": {"U": [{"start": 0, "end": null, "value": true}]},
