  },
  "s5a_P_unknown_input_off": {
   "initial": {"S": true, "P": "unknown"},
   "inputs": {"U": [{"start": 0, "end": null, "value": true}]},
   "clamps": [{"target": "U", "value": false, "start": 1, "end": null}]
  },
  "s5b_U_unknown": {
   "initial": {"S": true, "P": true},
   "inputs": {"U": [{"start": 0, "end": null, "value": "unknown"}]},
